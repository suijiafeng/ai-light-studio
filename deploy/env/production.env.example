# ============================================
# 生产环境配置模板
# 使用: cp deploy/env/production.env.example deploy/env/production.env 后逐项修改
# 部署: ./deploy.sh production
# ============================================

# 宿主机端口（Nginx 反代指向它）
APP_PORT=3000

# ---- 安全（必改！）----
# 生成命令: openssl rand -hex 32
JWT_SECRET=__请改为随机长字符串__
ADMIN_EMAILS=你的管理员邮箱@example.com

# ---- AI出图（生产建议 replicate）----
AI_PROVIDER=replicate
REPLICATE_API_TOKEN=r8_xxx
REPLICATE_MODEL_VERSION=

# ---- 微信支付 V3（真实收款）----
PAY_PROVIDER=wechat
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_SERIAL=
WXPAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WXPAY_APIV3_KEY=
WXPAY_NOTIFY_URL=https://你的域名/api/pay/notify

# ---- 邮件验证码（生产建议开启，防批量注册薅算力）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_VERIFY=on

# ---- 计费（默认值见 server/.env.example，可按需覆盖）----
# FREE_CREDITS=20
# DAILY_CREDITS=5
# MEMBER_DISCOUNT=0.9
