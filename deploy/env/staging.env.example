# ============================================
# 测试（staging）环境配置模板
# 使用: cp deploy/env/staging.env.example deploy/env/staging.env 后按需修改
# 部署: ./deploy.sh staging
#
# 定位: 验证新版本的类生产环境——AI可接真实服务，支付保持沙箱（不产生真实扣款）
# ============================================

APP_PORT=3001

JWT_SECRET=staging-secret-也请改成随机串
ADMIN_EMAILS=你的管理员邮箱@example.com

# AI: 要验证真实出图效果就填 replicate；日常回归用 mock 更快更省
AI_PROVIDER=mock
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=

# 支付: 测试环境固定沙箱，充值流程可完整走通但不产生真实交易
PAY_PROVIDER=mock

# 邮件: 不配置SMTP时验证码打印到日志并随接口返回，方便测试
EMAIL_VERIFY=off
