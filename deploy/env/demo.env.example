# ============================================
# 演示（demo）环境配置模板
# 使用: cp deploy/env/demo.env.example deploy/env/demo.env
# 部署: ./deploy.sh demo --seed   （--seed 自动创建演示账号）
#
# 定位: 给客户/投资人看的环境——全mock零成本、注册即送大额算力、开箱即用
# 演示账号（--seed 创建）: admin@demo.com / demo@demo.com，密码见 deploy.sh 输出
# ============================================

APP_PORT=3002

JWT_SECRET=demo-secret-随意但别用于生产
ADMIN_EMAILS=admin@demo.com

# 全部模拟模式：无需任何密钥，出图/支付全流程可演示
AI_PROVIDER=mock
PAY_PROVIDER=mock
EMAIL_VERIFY=off

# 演示友好的计费参数：注册送100、每日送20，够反复演示
FREE_CREDITS=100
DAILY_CREDITS=20
