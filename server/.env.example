# ================= 基础配置 =================
PORT=3000
# 生产环境务必修改为随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
# 数据库文件路径
DB_PATH=./data/app.db
# 上传/结果文件目录
UPLOAD_DIR=./data/uploads
RESULT_DIR=./data/results
# 管理员账号邮箱（注册后自动获得admin角色，逗号分隔可多个）
ADMIN_EMAILS=fushuai.gao@icloud.com

# ================= 算力计费 =================
# 新用户注册赠送算力
FREE_CREDITS=20
# 每次AI生成消耗算力
COST_PER_GENERATION=5
# 每日登录奖励算力
DAILY_CREDITS=5
# 4风格连拍消耗算力
MULTI_COST=8
# 会员购算力包折扣（0.9=9折，1=不打折）
MEMBER_DISCOUNT=0.9

# ================= 免费/付费分层 =================
# 免费用户出图最大边长（px），带水印
FREE_MAX_SIZE=1024
# 会员/付费用户出图最大边长（px），无水印
PREMIUM_MAX_SIZE=2048
WATERMARK_TEXT=代码工匠AI灯光设计

# ================= 邮箱服务（SMTP）=================
# 不配置则为开发模式：验证码打印到控制台并随接口返回
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 注册是否强制邮箱验证码：on/off
EMAIL_VERIFY=off

# ================= AI 模型（IC-Light）=================
# 模式：mock=本地模拟出图（无需密钥，可完整跑通流程演示）
#       replicate=对接 Replicate 上的 IC-Light 模型
AI_PROVIDER=mock
# fal.ai 密钥（fal托管IC-Light，dashboard/keys创建）
FAL_API_KEY=
FAL_MODEL=fal-ai/iclight-v2
# 提示：AI模式支持在管理后台运行时切换（演示mock/真实fal），无需改此处重启
# Replicate API Token（AI_PROVIDER=replicate 时必填）
REPLICATE_API_TOKEN=
# IC-Light 模型版本ID（Replicate上 zsxkib/ic-light 等模型的 version id）
REPLICATE_MODEL_VERSION=
# 生成超时（毫秒）
AI_TIMEOUT_MS=180000

# ================= LLM灯光顾问（可选）=================
# OpenAI兼容接口（OpenAI/DeepSeek/通义/Kimi等均可）
# 不配置则使用内置规则推荐，功能照常可用
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ================= 微信支付 V3 =================
# 模式：mock=沙箱模拟支付（无需商户号，可完整跑通充值流程）
#       wechat=真实微信Native支付V3
PAY_PROVIDER=mock
WXPAY_APPID=
WXPAY_MCHID=
# 商户API证书序列号
WXPAY_SERIAL=
# 商户API私钥文件路径（apiclient_key.pem）
WXPAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
# APIv3密钥（32位）
WXPAY_APIV3_KEY=
# 支付结果回调地址（须公网可访问HTTPS）
WXPAY_NOTIFY_URL=https://your-domain.com/api/pay/notify

# 超级管理员邮箱（最高权限：可授权/封禁/删除管理员；管理员之间不可互相操作）
SUPER_ADMIN_EMAILS=
